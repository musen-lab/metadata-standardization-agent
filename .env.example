# REQUIRED: OpenAI API key for LLM calls.
OPENAI_API_KEY=your-openai-api-key

# OPTIONAL: route every LLM call through an OpenAI-compatible gateway instead of
# api.openai.com. Leave unset to call OpenAI directly.
# OPENAI_BASE_URL=

# OPTIONAL: what the endpoint charges, as a fraction of OpenAI's published prices.
# The recorded cost is an estimate computed locally from provider-reported token counts.
# OPENAI_COST_MULTIPLIER=0.5
# OPENAI_COST_CACHE_DISCOUNT=false

# REQUIRED: CEDAR Metadata Center API key for fetching templates
CEDAR_API_KEY=your-cedar-api-key

# REQUIRED: BioPortal API key for ontology term lookups
BIOPORTAL_API_KEY=your-bioportal-api-key

# OPTIONAL: Langfuse tracing — enables observability for LLM calls and agent runs.
# Get the keys from your Langfuse project settings.
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# OPTIONAL: Label to separate runs within the project (e.g. development, evaluation).
# Use lowercase alphanumeric plus hyphens and underscores; must not start with "langfuse".
# LANGFUSE_TRACING_ENVIRONMENT=development

# Set to false to keep the keys configured but send nothing.
# LANGFUSE_TRACING_ENABLED=true
